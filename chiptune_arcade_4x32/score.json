{
  "format": "ox1-multitrack-score",
  "format_version": 1,
  "name": "芯片街机（4 轨 × 32 步）",
  "desc": "**8-bit 街机曲**：Supersaw 当方波主奏（算法 5 的载波本身就是方波 ⇒ 天然像芯片脉冲波），羽管键琴跑十六分音符琶音，拨弦当脉冲贝斯，金属打击当噪声鼓组（底鼓/军鼓/hi-hat 三层）。**四轨全在十六分音符上跑**，是本包密度最高的一首，循环起来像街机演示模式。",
  "key": "A 小调（Am–F–C–G，每 8 步 = 半小节一换）",
  "step_ms": 100,
  "loop": 1,
  "total_steps": 32,
  "gate_semantics": "★ 每轨的音符是 **dur 步的门**（dur ≥ 1）—— 与板上音序器的「门 = 1 步」是同一套语义，只是这里允许把门拉长。",
  "timbre_source": "mega60k/rtl/top/patch_bank.v —— 板级音色库 8 套（预设号 0..7）；参数与 tools/patch_designer/presets.json 里 board_id=0..7 逐比特相同",
  "voice_map": "mega60k/rtl/app/seq_play4.v:32-35 —— 4 轨各占一个专用引擎声部 124..127（页 7、低 4 位 12..15）；每轨音色靠引擎的 part 区分（0xD0+v 写 part_idx，N_PART=4，mega60k/rtl/audio/fm_engine.v:47-49,69）",
  "key_range": "0=C3 … 23=B4（本曲实际用到 0..23，越界音（>23）数量 = 0）",
  "fx": {
    "en": 1,
    "room": 2,
    "damp": 6,
    "wet": 2,
    "spread": 1,
    "width": 15,
    "predelay": 0
  },
